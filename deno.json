{
  "tasks": {
    "check-env": "deno run -A --env-file=./deno.env check-env.ts",
    "query": "deno run -A --env-file=./deno.env compass-query.ts",
    "test-mail": "deno run -A --env-file=./deno.env test-mail.ts",
    "sync": "deno run -A --env-file=./deno.env sync.ts",
    "evening-check": "deno run -A --env-file=./deno.env sync.ts --evening-check",
    "report": "deno run -A --env-file=./deno.env report.ts",
    "email-preview": "deno run -A --env-file=./deno.env email-preview.ts",
    "send-report": "deno run -A --env-file=./deno.env send-report.ts",
    "send-status-group-report": "deno run -A --env-file=./deno.env send-status-group-report.ts",
    "cron": "deno run -A --unstable-cron --env-file=./deno.env cron.ts"
  },
  "fmt": {
    "semiColons": false,
    "singleQuote": true,
    "include": ["**"],
    "lineWidth": 90
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@std/csv": "jsr:@std/csv@^1.0.0",
    "@std/path": "jsr:@std/path@^1.0.0",
    "nodemailer": "npm:nodemailer@^7.0.13",
    "postgres": "https://deno.land/x/postgresjs/mod.js"
  }
}
