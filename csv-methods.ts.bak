import { parse } from '@std/csv/parse'
import { join } from '@std/path/join'

/**
 * Reads the 'csv' directory and returns an array of absolute paths for all CSV files.
 * @returns An array of absolute paths to the CSV files.
 */
export async function getAbsCsvPaths(): Promise<string[]> {
  const currentWorkingDir = Deno.cwd()
  const csvDirPath = join(currentWorkingDir, 'csv')
  const csvFiles: string[] = []
  for await (const dirEntry of Deno.readDir(csvDirPath)) {
    if (dirEntry.isFile && dirEntry.name.endsWith('.csv')) {
      csvFiles.push(join(csvDirPath, dirEntry.name))
    }
  }
  return csvFiles
}

/**
 * Reads a CSV file and returns its content as an array of objects.
 * Only includes rows where 'SchoolSystemCountedAbsence' is 'True'.
 * @param filePath The absolute path to the CSV file.
 * @returns A promise that resolves to an array of objects representing the filtered CSV data.
 */
export async function readCsv<T extends { SchoolSystemCountedAbsence?: string }>(
  filePath: string,
): Promise<T[]> {
  const fileContent = await Deno.readTextFile(filePath)
  const parsedData = parse(fileContent, {
    skipFirstRow: true,
    header: true,
  }) as T[]

  // Filter the data based on 'SchoolSystemCountedAbsence' property
  const filteredData = parsedData.filter(
    (row) => row.SchoolSystemCountedAbsence === 'True',
  )

  return filteredData
}
